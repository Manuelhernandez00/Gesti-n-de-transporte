# URL de conexión PostgreSQL/Supabase. No subas el archivo .env real.
DATABASE_URL=postgresql://neondb_owner:npg_mBTRiOyjv7J3@ep-soft-silence-b5n2v26o-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Orígenes permitidos separados por comas. Añade aquí la URL de tu frontend publicado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Texto largo y aleatorio para firmar los inicios de sesión.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Envío de reportes por correo (opcional). Con Gmail usa una
# "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en dos pasos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
